
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <LangVersion>latest</LangVersion>
    <RootNamespace>Imputation_App</RootNamespace>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>


	 <PublishSingleFile>true</PublishSingleFile>
	 <SelfContained>true</SelfContained>
	 <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	 <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	 <PublishReadyToRun>true</PublishReadyToRun>

  </PropertyGroup>

  <ItemGroup>
    <None Remove="Logo\pitt_seal_white_center.png" />
    <None Remove="Logo\upmc-logo-white.png" />
    <None Remove="Reference\Antigen_to_OneFieldMol_Final_02192024.csv" />
    <None Remove="Reference\g-group_conversion_table.csv" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Logo\pitt_seal_white_center.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Logo\upmc-logo-white.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Reference\A-C-B-DRB-DQ-DP_Haplotypes_Dataframe.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Reference\Antigen_to_OneFieldMol_Final_02192024.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Reference\g-group_conversion_table.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="LoadingWindow.xaml">
      <Generator></Generator>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Page>
  </ItemGroup>

</Project>

