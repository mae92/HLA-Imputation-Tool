<Window x:Class="HLAImputation.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building HLA Reference Database"
        Width="520"
        Height="260"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Preparing HLA Reference Database"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Initializing..."
                   TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <TextBlock Grid.Row="2"
                   Text="Reference panel import"/>

        <ProgressBar x:Name="RefProgress"
                     Grid.Row="3"
                     Minimum="0"
                     Maximum="100"
                     Height="22"
                     Margin="0,5,0,15"/>

        <StackPanel Grid.Row="4">
            <TextBlock Text="SQLite database construction"/>

            <ProgressBar x:Name="DbProgress"
                         Minimum="0"
                         Maximum="100"
                         Height="22"
                         Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>