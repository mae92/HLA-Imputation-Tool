<Window x:Class="HLAImputation.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading"
        Height="200" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Closing="Window_Closing">


    <StackPanel Margin="20">
        <TextBlock x:Name="StatusText"
                   Text="Initializing..."
                   FontSize="14"
                   Margin="0,0,0,12"/>

        <TextBlock Text="Reference file load"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="0,0,0,4"/>
        <ProgressBar x:Name="RefProgress"
                     Height="22"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>

        <Rectangle Height="10" Opacity="0"/>

        <TextBlock Text="Reference database build"
                   FontSize="12"
                   Foreground="Gray"
                   Margin="0,0,0,4"/>
        <ProgressBar x:Name="DbProgress"
                     Height="22"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>

        <TextBlock Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="Gray"
                   Text="First run may take a few minutes while the reference database is built."/>
    </StackPanel>
</Window>
