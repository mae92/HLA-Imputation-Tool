<Window x:Class="HLAImputation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HLA Imputation Tool" Height="820" Width="1200">

    <DockPanel>

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top"
                    Background="#2C3E50" Height="60" VerticalAlignment="Center">

            <TextBlock Text="HLA Imputation Tool"
                       Foreground="White"
                       FontWeight="Bold" 
                       FontSize="32"
                       Margin="10,0"
                       VerticalAlignment="Center"/>

            <Button Content="Upload CSV" Width="120" Margin="70,15,10,15" Click="UploadCsv_Click"/>
            <Button Content="Run Imputation" Width="120" Margin="10,15,10,15" Click="Run_Click"/>
            <Button Content="Export Excel" Width="120" Margin="10,15,10,15" Click="Export_Click"/>

            <!-- Spacer -->
            <Grid HorizontalAlignment="Stretch"/>

            <!-- Logos -->
            <Image Source="Logo/upmc-logo-white.png"
                   Height="50"
                   Margin="160,0,20,0"
                   VerticalAlignment="Center"/>

            <Image Source="Logo/pitt_seal_white_center.png"
                   Height="45"
                   Margin="5,0,20,0"
                   VerticalAlignment="Center"/>

        </StackPanel>

        <!-- SETTINGS -->
        <Border DockPanel.Dock="Top"
                Background="#FAFAFA"
                Padding="10"
                BorderBrush="#DDD"
                BorderThickness="0,0,0,2">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.7*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Input -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Input Type" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <RadioButton x:Name="rbSerological" Content="Serological" Margin="0,0,12,0"/>
                            <RadioButton x:Name="rbMolecular" Content="Molecular" IsChecked="True"/>
                        </StackPanel>

                        <TextBlock Text="Resolution" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <RadioButton x:Name="rbRaw" Content="User Provided" IsChecked="True" Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbTwoField" Content="2-field" Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbOneField" Content="1-field"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- G Group -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,5">
                        <TextBlock Text="Convert Input to G-Groups" FontWeight="SemiBold"/>
                        <CheckBox x:Name="cbConvertToGGroup"
                                  Content="Enable G-Group Conversion"
                                  IsChecked="True"/>
                    </StackPanel>


                    <!-- Match Requirement -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,5">
                        <TextBlock Text="Match Requirement" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <RadioButton x:Name="rbMustMatch"
                     Content="Must Match Input (Strict)"
                     IsChecked="True"
                     Margin="0,0,12,0"/>
                            <RadioButton x:Name="rbAllowMismatch"
                     Content="Allow Mismatch"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Iterative Approach? -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Iterate" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,0,0,5">
                            <CheckBox x:Name="cbUseIterativeApproach" Content="Use Iterative Approach" Margin="0,0,12,0"/>
                        </WrapPanel>
                    </StackPanel>


                    <!-- View Options -->
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="View Options" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,0,0,5">
                            <CheckBox x:Name="cbShowRawInput" Content="Show Raw Input" Margin="0,0,12,0"/>
                            <CheckBox x:Name="cbShowVariants" Content="Show Variants" Margin="0,0,12,0"/>
                            <CheckBox x:Name="cbShowOnlySuccessful" Content="Only Successful"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- MIDDLE COLUMN -->
                <StackPanel Grid.Column="1" Margin="0,0,15,0">


                    <TextBlock Text="Loci Included" FontWeight="SemiBold" Margin="0,0,0,5"/>

                    <UniformGrid Columns="6" Margin="0,5,0,8">
                        <CheckBox x:Name="cbA" Content="A" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="cbB" Content="B" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="cbC" Content="C" Margin="0,2"/>
                        <CheckBox x:Name="cbDRB1" Content="DRB1" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="cbDRB345" Content="DRB345" Margin="0,2"/>
                        <CheckBox x:Name="cbDQB1" Content="DQB1" Margin="0,2" IsChecked="True"/>
                        <CheckBox x:Name="cbDQA1" Content="DQA1" Margin="0,2"/>
                        <CheckBox x:Name="cbDPB1" Content="DPB1" Margin="0,2"/>
                        <CheckBox x:Name="cbDPA1" Content="DPA1" Margin="0,2"/>
                    </UniformGrid>


                    <TextBlock Text="Search Order" FontWeight="SemiBold"/>

                    <UniformGrid Columns="9" Rows="2">
                        <TextBlock Text="A"/>
                        <TextBlock Text="B"/>
                        <TextBlock Text="C"/>
                        <TextBlock Text="DRB1"/>
                        <TextBlock Text="DRB345"/>
                        <TextBlock Text="DQB1"/>
                        <TextBlock Text="DQA1"/>
                        <TextBlock Text="DPB1"/>
                        <TextBlock Text="DPA1"/>

                        <ComboBox x:Name="ddA"/>
                        <ComboBox x:Name="ddB"/>
                        <ComboBox x:Name="ddC"/>
                        <ComboBox x:Name="ddDRB1"/>
                        <ComboBox x:Name="ddDRB345"/>
                        <ComboBox x:Name="ddDQB1"/>
                        <ComboBox x:Name="ddDQA1"/>
                        <ComboBox x:Name="ddDPB1"/>
                        <ComboBox x:Name="ddDPA1"/>
                    </UniformGrid>


                    <StackPanel HorizontalAlignment="Left" Margin="0,5,0,5">
                        <TextBlock Text="Max Haplotypes to Search" FontWeight="SemiBold"/>
                        <TextBox x:Name="tbTopHaps"
                                   Text="1000000"
                                   Width="100"
                                   Margin="0,2,0,5"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>


                </StackPanel>

                <!-- QC -->

                <GroupBox Grid.Column="2" Header="QC Summary" MaxHeight="220" VerticalAlignment="Top">
                    <TextBox x:Name="QcReportTextBox"
                            Height="150"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            FontFamily="Consolas"/>
                </GroupBox>


            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="10">
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="650"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ImputeStatusText" Text="Ready"/>
                <ProgressBar x:Name="ImputeProgressBar" Grid.Column="1"/>
                <TextBlock x:Name="ImputePercentText" Grid.Column="2" Text="0%" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- INPUT -->
            <DataGrid x:Name="InputGrid"
                      Grid.Row="0"
                      Margin="10"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="InputGrid_AutoGeneratingColumn"
                      MouseDoubleClick="InputGrid_DoubleClick"/>

            <!-- RESULT -->
            <DataGrid x:Name="ResultGrid"
                      Grid.Row="1"
                      Margin="10"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="ResultGrid_AutoGeneratingColumn"
                      MouseDoubleClick="ResultGrid_DoubleClick"/>

            <!-- ✅ CLEAN FOOTER -->
            <Border Grid.Row="2"
                    Background="#F8F8F8"
                    BorderBrush="#DDD"
                    BorderThickness="0,1,0,0"
                    Padding="10"
                    Margin="10,0,10,10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock FontWeight="SemiBold"
                                   Text="HLA Imputation Tool (Version 1.0)"/>
                        <TextBlock Text="Mitchell Ellison, PhD &amp; Qingyong Xu, PhD, F(ACHI)"
                                   FontSize="12"/>
                        <TextBlock Text="UPMC / University of Pittsburgh"
                                   FontSize="12"/>
                    </StackPanel>

                    <!-- RIGHT -->
                    <StackPanel Grid.Row="0" Grid.Column="1"
                                HorizontalAlignment="Right">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Reference Dataset"/>
                        <TextBlock Text="Gragert L et al. bioRxiv 2026"
                                   FontSize="12"
                                   TextAlignment="Right"/>
                    </StackPanel>

                    <!-- FULL WIDTH -->

                    <TextBlock Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            FontSize="12">

                            <Run Text="How to cite:" FontWeight="SemiBold"/>
                            <Run Text=" Ellison MA II, Xu Q. HLA Imputation Tool (Starzl Institute, UPMC)."/>

                    </TextBlock>


                </Grid>

            </Border>

        </Grid>

    </DockPanel>
</Window>
