<Window x:Class="HLAImputation.SingleSampleInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Single Sample Input"
        Width="1180"
        Height="820"
        MinWidth="950"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <DockPanel Margin="12">

        <Border DockPanel.Dock="Bottom"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Text="Enter typing manually or import a report."/>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Width="100"
                        Margin="8,0"
                        Click="Cancel_Click"/>

                <Button Grid.Column="2"
                        Content="Load Sample"
                        Width="120"
                        FontWeight="SemiBold"
                        Click="LoadSample_Click"/>
            </Grid>
        </Border>

        <TabControl>

            <TabItem Header="Typing Review">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <GroupBox Header="Sample Information"
                                  Margin="0,0,0,12">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Sample ID:"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Name="SampleIdTextBox"
                                         Grid.Column="1"
                                         Margin="6"/>

                                <TextBlock Grid.Column="2"
                                           Text="Ethnicity:"
                                           VerticalAlignment="Center"/>

                                <ComboBox x:Name="EthnicityComboBox"
                                          Grid.Column="3"
                                          Margin="6"
                                          IsEditable="True"/>

                                <TextBlock Grid.Column="4"
                                           Text="Patient Type:"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Name="PatientTypeTextBox"
                                         Grid.Column="5"
                                         Margin="6"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="HLA Typing">
                            <Grid x:Name="AlleleEntryGrid"
                                  Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Allele 1"
                                           FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="Allele 2"
                                           FontWeight="SemiBold"/>

                                <!-- A -->
                                <TextBlock Grid.Row="1"
                                           Text="A"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="A1TextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="A2TextBox"
                                         Grid.Row="1"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- B -->
                                <TextBlock Grid.Row="2"
                                           Text="B"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="B1TextBox"
                                         Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="B2TextBox"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- C -->
                                <TextBlock Grid.Row="3"
                                           Text="C"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="C1TextBox"
                                         Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="C2TextBox"
                                         Grid.Row="3"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- DRB1 -->
                                <TextBlock Grid.Row="4"
                                           Text="DRB1"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="DRB11TextBox"
                                         Grid.Row="4"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="DRB12TextBox"
                                         Grid.Row="4"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- DRB3 -->
                                <TextBlock Grid.Row="5"
                                           Text="DRB3"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="DRB31TextBox"
                                         Grid.Row="5"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="DRB32TextBox"
                                         Grid.Row="5"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- DRB4 -->
                                <TextBlock Grid.Row="6"
                                           Text="DRB4"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="DRB41TextBox"
                                         Grid.Row="6"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="DRB42TextBox"
                                         Grid.Row="6"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- DRB5 -->
                                <TextBlock Grid.Row="7"
                                           Text="DRB5"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="DRB51TextBox"
                                         Grid.Row="7"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="DRB52TextBox"
                                         Grid.Row="7"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- DQA1 -->
                                <TextBlock Grid.Row="8"
                                           Text="DQA1"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="DQA11TextBox"
                                         Grid.Row="8"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="DQA12TextBox"
                                         Grid.Row="8"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- DQB1 -->
                                <TextBlock Grid.Row="9"
                                           Text="DQB1"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="DQB11TextBox"
                                         Grid.Row="9"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="DQB12TextBox"
                                         Grid.Row="9"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- DPA1 -->
                                <TextBlock Grid.Row="10"
                                           Text="DPA1"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="DPA11TextBox"
                                         Grid.Row="10"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="DPA12TextBox"
                                         Grid.Row="10"
                                         Grid.Column="2"
                                         Margin="4"/>

                                <!-- DPB1 -->
                                <TextBlock Grid.Row="11"
                                           Text="DPB1"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="DPB11TextBox"
                                         Grid.Row="11"
                                         Grid.Column="1"
                                         Margin="4"/>
                                <TextBox x:Name="DPB12TextBox"
                                         Grid.Row="11"
                                         Grid.Column="2"
                                         Margin="4"/>

                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Import Warnings"
                                  Margin="0,12,0,0">
                            <TextBox x:Name="WarningsTextBox"
                                     Margin="10"
                                     Height="100"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Import Report">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel>
                        <Button Content="Paste Screenshot"
                                Width="140"
                                Margin="0,0,8,8"
                                Click="PasteScreenshot_Click"/>

                        <Button Content="Open Image"
                                Width="120"
                                Margin="0,0,8,8"
                                Click="OpenImage_Click"/>

                        <Button Content="Open PDF"
                                Width="120"
                                Margin="0,0,8,8"
                                Click="OpenPdf_Click"/>

                        <Button Content="Open Text File"
                                Width="120"
                                Margin="0,0,8,8"
                                Click="OpenTextFile_Click"/>

                        <Button Content="Parse Extracted Text"
                                Width="160"
                                Margin="0,0,8,8"
                                Click="ParseText_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="1"
                            BorderBrush="#999"
                            BorderThickness="1"
                            Background="#F8F8F8"
                            Margin="0,4,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Drop a PDF, image, or text file here"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Supported: PDF, PNG, JPG, JPEG, BMP, TIFF, TXT"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Foreground="#666"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="Extracted text. Review or edit before parsing:"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="ExtractedTextBox"
                             Grid.Row="3"
                             Margin="0,5,0,0"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"/>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>